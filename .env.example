# Skopiuj do pliku .env i dostosuj przed wdrożeniem produkcyjnym.

# Tożsamość procesu w kontenerze — musi odpowiadać właścicielowi katalogu ./data,
# dzięki czemu kopie zapasowe czytasz bez podnoszenia uprawnień.
# Ustal wartości poleceniem: id -u ; id -g
QUIZAPP_UID=1000
QUIZAPP_GID=1000

# Port na hoście, pod którym wystawiony jest interfejs.
QUIZAPP_PORT=8080

# Klucz podpisujący tokeny sesji. Wygeneruj:  openssl rand -base64 48
QUIZAPP_SECRET_KEY=

# Ustaw true, jeżeli aplikacja działa za odwrotnym proxy z certyfikatem HTTPS.
QUIZAPP_COOKIE_SECURE=false

# Pozwolenie na samodzielną rejestrację kont przez użytkowników.
QUIZAPP_ALLOW_REGISTRATION=true

# Strefa czasowa kontenera.
TZ=Europe/Warsaw
