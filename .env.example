# Skopiuj do pliku .env i dostosuj przed wdrożeniem produkcyjnym.

# Tożsamość procesu w kontenerze — musi odpowiadać właścicielowi katalogu ./data,
# dzięki czemu kopie zapasowe czytasz bez podnoszenia uprawnień.
# Ustal wartości poleceniem: id -u ; id -g
QUIZAPP_UID=1000
QUIZAPP_GID=1000

# Port na hoście, pod którym wystawiony jest interfejs.
QUIZAPP_PORT=8080

# Klucz podpisujący tokeny sesji. Wygeneruj:  openssl rand -base64 48
QUIZAPP_SECRET_KEY=

# Ustaw true, jeżeli aplikacja działa za odwrotnym proxy z certyfikatem HTTPS.
QUIZAPP_COOKIE_SECURE=false

# Pozwolenie na samodzielną rejestrację kont przez użytkowników.
QUIZAPP_ALLOW_REGISTRATION=true

# Transkrypcja nagrań — kontener startuje razem z aplikacją (1 = włączony, 0 = wyłączony).
# Ustaw 0 tylko wtedy, gdy transkrypcję liczy usługa na hoście (scripts/zainstaluj-usluge.sh).
QUIZAPP_TRANSKRYPCJA_KONTENER=1

# Model Whispera. large-v3 daje najlepszą jakość, ale na procesorze jest wolny
# (godzina nagrania to kilka godzin liczenia). Szybsze: medium, small.
QUIZAPP_WHISPER_MODEL=large-v3

# Powiadomienia Pomodoro (Web Push) — kontakt do operatora przekazywany usługom push
# Apple, Google i Mozilli. Wpisz własny adres e-mail albo adres https:// instancji.
# Powiadomienia wymagają HTTPS (QUIZAPP_COOKIE_SECURE=true za odwrotnym proxy).
# QUIZAPP_PUSH_CONTACT=mailto:ty@example.com

# Strefa czasowa kontenera.
TZ=Europe/Warsaw
